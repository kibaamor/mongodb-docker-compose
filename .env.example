# MongoDB Version
# Specify the MongoDB Docker image version
# Examples: latest, 7.0, 6.0, 5.0
MONGO_VERSION=latest

# Mongo Express Version
# Specify the Mongo Express Docker image version
MONGO_EXPRESS_VERSION=latest

# Logging Configuration
# Maximum size of a single log file before rotation
MAX_LOG_FILE_SIZE=10m

# Maximum number of log files to keep
MAX_LOG_FILE_COUNT=3

# Single Instance Configuration
# Bind address for the single MongoDB instance
# Use 127.0.0.1 for localhost only, or 0.0.0.0 for all interfaces
MONGO_BIND_ADDRESS=127.0.0.1

# External port for accessing the single MongoDB instance
MONGO_PORT=27017

# CPU limit for the single MongoDB instance (in cores)
MONGO_CPU_LIMIT=1.0

# Memory limit for the single MongoDB instance
# Examples: 512M, 1G, 2G
MONGO_MEM_LIMIT=1G

# Cluster Router Configuration
# Bind address for the MongoDB router (mongos)
# Use 127.0.0.1 for localhost only, or 0.0.0.0 for all interfaces
MONGOS_BIND_ADDRESS=127.0.0.1

# External port for accessing the MongoDB router (mongos)
MONGOS_PORT=27017

# Mongo Express Configuration
# Bind address for Mongo Express web UI
# Use 127.0.0.1 for localhost only, or 0.0.0.0 for all interfaces
MONGO_EXPRESS_BIND_ADDRESS=127.0.0.1

# External port for accessing Mongo Express web UI
MONGO_EXPRESS_PORT=8081

# Config Server Resource Limits
# CPU limit for each config server (in cores)
CONFIG_SVR_CPU_LIMIT=0.7

# Memory limit for each config server
# Examples: 512M, 768M, 1G, 2G
CONFIG_SVR_MEM_LIMIT=768M

# Shard Server Resource Limits
# CPU limit for each shard server (in cores)
SHARD_SVR_CPU_LIMIT=1.0

# Memory limit for each shard server
# Examples: 1G, 2G, 4G
SHARD_SVR_MEM_LIMIT=2G

# Mongos Router Resource Limits
# CPU limit for mongos router (in cores)
MONGOS_CPU_LIMIT=0.5

# Memory limit for mongos router
# Examples: 256M, 512M, 1G
MONGOS_MEM_LIMIT=512M
